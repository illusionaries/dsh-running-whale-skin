{
  "name": "dsh-running-whale-skin",
  "version": "0.1.1",
  "description": "Swaps the light-mode animation of the running \"Deep diving\" status for a custom animated mark.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "theme",
    "ui"
  ],
  "license": "MIT",
  "author": "嘉",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/illusionaries/dsh-running-whale-skin.git"
  },
  "homepage": "https://github.com/illusionaries/dsh-running-whale-skin#readme",
  "bugs": {
    "url": "https://github.com/illusionaries/dsh-running-whale-skin/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "PROVENANCE.md",
    "assets/whale-64.gif",
    "tools/build-client.mjs"
  ],
  "scripts": {
    "build": "node tools/build-client.mjs",
    "prepublishOnly": "node tools/build-client.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "node": ">=22"
  }
}
